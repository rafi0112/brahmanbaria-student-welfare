# Copy to .env (git-ignored) and fill in. Never commit real values.
APP_ENV=development
PORT=8080
# Hosts usually set PORT (some set SERVER_PORT instead); the server uses PORT when set, otherwise SERVER_PORT, otherwise 8080.
# DATA_DIR: folder with students.json and alumni.json (default: data). Only a fallback: with APP_ENV=production they are
# needed only when the directory_records table is empty (the directory normally comes from Supabase).
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Supabase: Project Settings -> Database -> Connection string (URI). Use the pooler string on port 6543.
DATABASE_URL=

# Supabase Auth API verification. The URL is the project URL, without /rest/v1.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Local testing without a database (accounts vanish on restart). Leave false in production.
AUTH_DEV_MEMORY=false

# Cookies. For a frontend and API on different sites use COOKIE_SAMESITE=none and COOKIE_SECURE=true (HTTPS only).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Alternative to SMTP below: Brevo's HTTPS API (not used by the current deployment). MAIL_FROM must be a verified sender.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=BSWA

# First-admin bootstrap ONLY. Comma-separated emails read by `go run . bootstrap-admin --apply`.
# Setting this does nothing by itself: roles live in the database (users.role), and the command
# promotes only accounts that already exist in Supabase Auth with a confirmed email.
# After the first admin exists, manage admins from /admin > Admin management.
ADMIN_EMAILS=

# Contact form: the mailbox that receives a notification for every message sent through the public Contact section.
# This is a RECIPIENT, separate from MAIL_FROM (the sender identity). Replies to visitors are sent from MAIL_FROM
# with this address as Reply-To. Messages are kept 30 days in the database. Leave empty to store messages without notifying.
CONTACT_RECIPIENT_EMAIL=

# Member invitations (Supabase Auth admin API). SERVER SIDE ONLY: never put this key in the frontend or commit it.
# Use the new Secret key (sb_secret_...) from Supabase: Project Settings -> API Keys. The legacy service_role key still works below
# if it has not been disabled. Secret keys are not JWTs and are sent only in the apikey header. Without a key, "Send activation email" stays unavailable.
SUPABASE_SECRET_KEY=
# Emails themselves go through the SMTP settings configured in Supabase (Authentication -> SMTP); this app never sees that password.
SUPABASE_SERVICE_ROLE_KEY=
# Application-level safety limits (the stricter of these and Supabase's own email rate limit applies).
INVITE_MAX_PER_HOUR=20
INVITE_MAX_PER_DAY=100
INVITE_RESEND_COOLDOWN_MINUTES=60
# How long an invitation link stays valid; set it equal to Authentication -> Email -> "Email OTP expiration" in Supabase.
INVITE_LINK_EXPIRY_HOURS=24
# Where the invitation link lands (must be in Supabase Authentication -> URL Configuration -> Redirect URLs). Default: FRONTEND_URL/activate
INVITE_REDIRECT_URL=

# Optional, only for `go run . apply-email-template`: a Supabase personal access token (supabase.com/dashboard/account/tokens).
# Needed because email templates can only be changed with it (the Auth admin key cannot). Server side only, never committed.
SUPABASE_ACCESS_TOKEN=

# Outgoing email through an SMTP account, e.g. the same Gmail address + app password configured in Supabase (Authentication -> SMTP).
# Used for the contact-form notification and replies. Leave empty in development to print mail to the log. Server side only.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 (STARTTLS) or 465. SMTP_USER is also the default CONTACT_RECIPIENT_EMAIL.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
