# Copy to .env (git-ignored) and fill in. Never commit real values.
APP_ENV=development
PORT=8080
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Supabase: Project Settings -> Database -> Connection string (URI). Use the pooler string on port 6543.
DATABASE_URL=

# Supabase Auth API verification. The URL is the project URL, without /rest/v1.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Local testing without a database (accounts vanish on restart). Leave false in production.
AUTH_DEV_MEMORY=false

# Cookies. For a frontend and API on different sites use COOKIE_SAMESITE=none and COOKIE_SECURE=true (HTTPS only).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Brevo transactional email (required when APP_ENV=production). MAIL_FROM must be a verified sender.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=BSWA

# Comma-separated emails that become admins once their Supabase email is confirmed.
# Create the admin's Supabase account yourself first (turn "Confirm email" ON in Supabase Auth).
ADMIN_EMAILS=
