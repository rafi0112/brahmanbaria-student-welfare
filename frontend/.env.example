# Copy to frontend/.env (git-ignored). These two values are public by design (they ship in the browser bundle).
# Use the project URL (no /rest/v1) and the publishable (anon) key. Never put a secret / service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Only needed when the API runs on a different address than the dev proxy, e.g. https://api.example.com
VITE_API_BASE=
